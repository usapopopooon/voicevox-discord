# 単一Botで起動する場合に使用
DISCORD_TOKEN=
# 複数Botで起動する場合に使用（カンマ or 改行区切り）
# 複数運用時は DISCORD_TOKEN を空にして DISCORD_TOKENS を設定
DISCORD_TOKENS=
DATABASE_URL=postgresql://bot:bot@postgres:5432/voicevox_bot
DEFAULT_SPEAKER_ID=46
LOG_LEVEL=INFO
# DB接続プールサイズ（複数Bot時はインスタンスごとの上限を絞り総接続数を抑える）
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
TTS_AUDIO_QUERY_TIMEOUT_SECONDS=3
TTS_SYNTHESIS_TIMEOUT_SECONDS=8
TTS_SPEAKERS_TIMEOUT_SECONDS=3
RECENT_SYNTH_TTL_SECONDS=45
# Discord メッセージキャッシュ件数（discord.py の max_messages）。
# 読み上げ用途では小さくしてメモリを節約する。デフォルト 100。
DISCORD_MESSAGE_CACHE_SIZE=100
VOICEVOX_URL=http://voicevox:50021
# COEIROINK v1 を使う場合は COMPOSE_PROFILES を有効化
# COMPOSE_PROFILES=coeiroink
COEIROINK_URL=http://coeiroink:50031
# SHAREVOX_URL=http://sharevox:50025
